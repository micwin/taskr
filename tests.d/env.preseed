export TASKR_BASE_ROOT="${SMOKEY_STATE_DIR}/fixtures/base-root"
export TASKR_INVALID_ROOT="${SMOKEY_STATE_DIR}/fixtures/invalid-root"
export TASKR_EMPTY_ROOT="${SMOKEY_STATE_DIR}/fixtures/empty-root"
export TASKR_CONFIG_FILE="${SMOKEY_STATE_DIR}/config.yaml"
export TASKR_BIN="${SMOKEY_STATE_DIR}/bin/taskr"

run_command() {
  local name="$1"
  shift
  stdout="${SMOKEY_STATE_DIR}/${name}.stdout"
  stderr="${SMOKEY_STATE_DIR}/${name}.stderr"
  set +e
  "$@" >"${stdout}" 2>"${stderr}"
  exit_code=$?
  set -e
}

run_taskr() {
  local name="$1"
  shift
  run_command "${name}" "${TASKR_BIN}" "$@"
}

run_complete() {
  run_taskr "$@"
}

run_build() {
  run_command "$@"
}

new_root() {
  local name="$1"
  local suffix="${2:-}"
  local root="${SMOKEY_STATE_DIR}/${name}${suffix}"
  cp -R "${TASKR_BASE_ROOT}" "${root}"
  printf '%s\n' "${root}"
}
